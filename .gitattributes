# Normalize line endings: store LF in the repo and check out LF on every OS
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never diff or convert
*.zip      binary
*.parquet  binary
*.duckdb   binary
*.pdf      binary
*.png      binary
*.jpg      binary
